<header class="site-header" role="banner">
  <div class="site-header__inner">
    <a class="brand" href="{{ site.url }}/" aria-label="{{ site.shortTitle }} home">
      <svg class="brand__mark" width="36" height="36" viewBox="0 0 64 64" aria-hidden="true">
        <defs>
          <linearGradient id="brandBg" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#0e7c86"/><stop offset="1" stop-color="#1b3a4b"/>
          </linearGradient>
          <linearGradient id="brandEdge" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#f9c66b"/><stop offset="1" stop-color="#ff6b6b"/>
          </linearGradient>
        </defs>
        <rect x="2" y="2" width="60" height="60" rx="12" fill="url(#brandBg)"/>
        <g stroke="url(#brandEdge)" stroke-width="2.2" fill="none" stroke-linecap="round">
          <path d="M14 18 L32 32 L50 14"/><path d="M32 32 L20 48"/><path d="M32 32 L48 46"/><path d="M20 48 L48 46"/>
        </g>
        <g fill="#ffe28a">
          <circle cx="14" cy="18" r="4"/><circle cx="50" cy="14" r="4"/><circle cx="48" cy="46" r="4"/>
        </g>
        <circle cx="20" cy="48" r="4" fill="#ff8a5b"/>
        <circle cx="32" cy="32" r="5" fill="#ffffff"/>
        <circle cx="32" cy="32" r="2" fill="#0e7c86"/>
      </svg>
      <span class="brand__text">
        <span class="brand__primary">Spatial Graph Databases</span>
        <span class="brand__secondary">Python &middot; Neo4j &middot; Routing</span>
      </span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        <li>
          <a href="{{ site.url }}/" {% if page.url == "/" %}aria-current="page"{% endif %}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 3 2 12h3v8h5v-6h4v6h5v-8h3z"/></svg>
            <span>Home</span>
          </a>
        </li>
        {% for s in site.sections %}
        <li>
          <a href="{{ site.url }}/{{ s.slug }}/" {% if page.url.startsWith("/" + s.slug + "/") %}aria-current="page"{% endif %} style="--accent: {{ s.color }}">
            {% include "partials/icon-" + s.icon + ".njk" %}
            <span>{{ s.title }}</span>
          </a>
        </li>
        {% endfor %}
      </ul>
    </nav>
  </div>
</header>
