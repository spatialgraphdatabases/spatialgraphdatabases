<header class="site-header" role="banner">
  <div class="site-header__inner">
    <a class="brand" href="{{ site.url }}/" aria-label="{{ site.shortTitle }} home">
      <svg class="brand__mark" width="36" height="36" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id="brandBg" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#0e7c86"/><stop offset="1" stop-color="#1b3a4b"/>
          </linearGradient>
          <linearGradient id="brandEdge" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#f9c66b"/><stop offset="1" stop-color="#ff6b6b"/>
          </linearGradient>
        </defs>
        <rect x="2" y="2" width="60" height="60" rx="12" fill="url(#brandBg)"/>
        <g stroke="url(#brandEdge)" stroke-width="2.2" fill="none" stroke-linecap="round">
          <path d="M14 18 L32 32 L50 14"/><path d="M32 32 L20 48"/><path d="M32 32 L48 46"/><path d="M20 48 L48 46"/>
        </g>
        <g fill="#ffe28a">
          <circle cx="14" cy="18" r="4"/><circle cx="50" cy="14" r="4"/><circle cx="48" cy="46" r="4"/>
        </g>
        <circle cx="20" cy="48" r="4" fill="#ff8a5b"/>
        <circle cx="32" cy="32" r="5" fill="#ffffff"/>
        <circle cx="32" cy="32" r="2" fill="#0e7c86"/>
      </svg>
      <span class="brand__text">
        <span class="brand__primary">Spatial Graph Databases</span>
        <span class="brand__secondary">Python &middot; Neo4j &middot; Routing</span>
      </span>
    </a>

    {# Wide viewports: the sections inline. Labels are the SHORT form — the full
       titles do not fit on one row, and this row is never allowed to wrap. #}
    <nav class="site-nav" aria-label="Primary">
      <ul>
        <li>
          <a href="{{ site.url }}/" {% if page.url == "/" %}aria-current="page"{% endif %}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 3 2 12h3v8h5v-6h4v6h5v-8h3z"/></svg>
            <span>Home</span>
          </a>
        </li>
        {% for s in site.sections %}
        <li>
          <a href="{{ site.url }}/{{ s.slug }}/" {% if page.url.startsWith("/" + s.slug + "/") %}aria-current="page"{% endif %} class="sec sec--{{ s.key }}">
            {% include "partials/icon-" + s.icon + ".njk" %}
            <span>{{ s.navTitle or s.title }}</span>
          </a>
        </li>
        {% endfor %}
      </ul>
    </nav>

    <div class="header-tools">
      {# Narrow viewports: the same destinations plus every topic, in a disclosure
         panel. <details> so it opens and closes with no JavaScript at all. #}
      <details class="nav-menu" data-nav-menu>
        <summary class="nav-menu__btn" aria-label="Browse sections and topics">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M3 6h18v2H3zm0 5h18v2H3zm0 5h18v2H3z"/></svg>
          <span>Browse</span>
        </summary>
        <div class="nav-menu__panel">
          <nav aria-label="All sections and topics">
            <ul>
              <li class="nav-menu__group">
                <a href="{{ site.url }}/" {% if page.url == "/" %}aria-current="page"{% endif %}>
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 3 2 12h3v8h5v-6h4v6h5v-8h3z"/></svg>
                  Home
                </a>
              </li>
              {% for s in site.sections %}
              <li class="nav-menu__group">
                <a href="{{ site.url }}/{{ s.slug }}/" {% if page.url == "/" + s.slug + "/" %}aria-current="page"{% endif %} class="sec sec--{{ s.key }}">
                  {% include "partials/icon-" + s.icon + ".njk" %}
                  {{ s.navTitle or s.title }}
                </a>
                {% set topics = collections.content | directChildrenOf("/" + s.slug + "/") %}
                {% if topics.length %}
                <ul class="nav-menu__sub">
                  {% for t in topics %}
                  <li><a href="{{ t.url }}" {% if page.url == t.url %}aria-current="page"{% endif %}>{{ t.data.title }}</a></li>
                  {% endfor %}
                </ul>
                {% endif %}
              </li>
              {% endfor %}
            </ul>
          </nav>
        </div>
      </details>

      <button class="theme-toggle" type="button" data-theme-toggle
              aria-label="Switch between light and dark theme">
        <svg class="theme-toggle__sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="4.4" fill="currentColor"/>
          <g stroke="currentColor" stroke-width="1.9" stroke-linecap="round">
            <path d="M12 2.4v2.6M12 19v2.6M2.4 12h2.6M19 12h2.6M5.2 5.2l1.9 1.9M16.9 16.9l1.9 1.9M18.8 5.2l-1.9 1.9M7.1 16.9l-1.9 1.9"/>
          </g>
        </svg>
        <svg class="theme-toggle__moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M20.7 14.6A8.6 8.6 0 0 1 9.4 3.3a0.9 0.9 0 0 0-1.2-1.1 10.4 10.4 0 1 0 13.6 13.6 0.9 0.9 0 0 0-1.1-1.2z"/>
        </svg>
      </button>
    </div>
  </div>
</header>
